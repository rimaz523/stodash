{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sec": {
    // SEC asks automated clients for a name and contact email, e.g. "Stodash you@example.com".
    // Don't put your email here; set it with: dotnet user-secrets set "Sec:UserAgent" "Stodash you@example.com"
    "UserAgent": ""
  },
  "Finnhub": {
    // Free key from https://finnhub.io/dashboard: live watchlist prices (W), extra news (N), quote/profile fallback.
    // Don't put it here; set it with: dotnet user-secrets set "Finnhub:ApiKey" "YOUR_KEY"
    "ApiKey": ""
  },
  "Fred": {
    // Free key from https://fred.stlouisfed.org/docs/api/api_key.html, used by ECO (phase 3).
    // Don't put it here; set it with: dotnet user-secrets set "Fred:ApiKey" "YOUR_KEY"
    "ApiKey": ""
  },
  "CoinGecko": {
    // Optional free "demo" key for higher limits; CRYPTO works without one.
    "ApiKey": ""
  }
}
